#include <metal_stdlib>
#include "generic_star_texture.msl"
using namespace metal;

struct StarInstance {
    packed_float3 position; // Camera-relative position in render units
    float radius;           // Base physical radius in render units
    float4 color;           // Spectral color (RGBA)
};

struct StarUniforms {
    float4x4 viewMatrix;
    float4x4 projectionMatrix;
    float minSizeFactor;
    float time;
    float2 _pad;
};

struct StarVertexOut {
    float4 position [[position]];
    float2 uv;
    float4 color;
    float close_factor;
    float time;
    float3 cam_right;
    float3 cam_up;
    float3 cam_back;
    float seed;
};

struct StarFragmentOut {
    float4 color [[color(0)]];
    float depth [[depth(any)]];
};

// Billboard quad vertices (2 triangles, 6 vertices)
constant float2 quad_corners[6] = {
    float2(-1.0f, -1.0f),
    float2( 1.0f, -1.0f),
    float2(-1.0f,  1.0f),
    float2(-1.0f,  1.0f),
    float2( 1.0f, -1.0f),
    float2( 1.0f,  1.0f)
};

vertex StarVertexOut star_vertex(
    uint vid [[vertex_id]],
    uint iid [[instance_id]],
    constant StarUniforms &uniforms [[buffer(0)]],
    const device StarInstance *instances [[buffer(1)]])
{
    StarVertexOut out;
    StarInstance star = instances[iid];

    // star.position is in camera-relative render units: (star_pos - camera.center)
    float4 view_pos = uniforms.viewMatrix * float4(float3(star.position), 1.0f);

    // If point is behind the camera near plane, clip it
    if (view_pos.z >= -0.001f) {
        out.position = float4(0.0f, 0.0f, 2.0f, 1.0f);
        out.uv = float2(0.0f);
        out.color = float4(0.0f);
        out.close_factor = 0.0f;
        out.time = 0.0f;
        out.cam_right = float3(1.0f, 0.0f, 0.0f);
        out.cam_up = float3(0.0f, 1.0f, 0.0f);
        out.cam_back = float3(0.0f, 0.0f, 1.0f);
        out.seed = 0.0f;
        return out;
    }

    float dist = length(view_pos.xyz);

    // Dynamic sizing:
    // When far away, star.radius < min_visual_size, maintaining visibility as a point.
    // When closing in, star.radius dominates, defining the true physical celestial sphere.
    float min_visual_size = dist * uniforms.minSizeFactor;
    float render_scale = max(star.radius, min_visual_size);

    // Transition from distant point glow (0.0) to physically resolved sphere (1.0).
    // Begins resolving when physical radius approaches min_visual_size.
    float close_factor = clamp((star.radius / max(min_visual_size, 1e-6f) - 0.7f) / 1.3f, 0.0f, 1.0f);

    // Quad expansion in view space:
    // At r=1.0 is the physical star boundary.
    // Margin provides room for radiant glow at distance and corona up close.
    float margin = mix(1.15f, 1.25f, close_factor);
    float quad_scale = render_scale * margin;

    float2 corner = quad_corners[vid];
    view_pos.xy += corner * quad_scale;

    out.position = uniforms.projectionMatrix * view_pos;
    out.uv = corner * margin; // uv distance 1.0 is the physical boundary
    out.color = star.color;
    out.close_factor = close_factor;
    out.time = uniforms.time;

    // Extract camera basis vectors in world space from viewMatrix rotation
    out.cam_right = float3(uniforms.viewMatrix[0][0], uniforms.viewMatrix[1][0], uniforms.viewMatrix[2][0]);
    out.cam_up    = float3(uniforms.viewMatrix[0][1], uniforms.viewMatrix[1][1], uniforms.viewMatrix[2][1]);
    out.cam_back  = float3(uniforms.viewMatrix[0][2], uniforms.viewMatrix[1][2], uniforms.viewMatrix[2][2]);

    // Unique per-star procedural seed based on world position
    out.seed = fract(sin(dot(float3(star.position), float3(12.9898f, 78.233f, 45.164f))) * 43758.5453f);

    return out;
}

fragment StarFragmentOut star_fragment(StarVertexOut in [[stage_in]]) {
    StarFragmentOut out;
    float r = length(in.uv);
    float close = in.close_factor;

    // --- MODE 1: DISTANT STAR FAST-PATH (close < 0.01f) ---
    // 99.999% of stars in large clusters. Uses 1-cycle quadratic falloff with zero
    // transcendentals (no pow/sqrt/smoothstep), eliminating fillrate bottlenecks.
    if (close < 0.01f) {
        float d = 1.0f - (r / 1.15f);
        if (d <= 0.0f) {
            discard_fragment();
        }
        out.color = float4(in.color.rgb, d * d);
        out.depth = 1.0f;
        return out;
    }

    // --- MODE 2: CLOSE-UP SPHERICAL BODY (close >= 0.01f) ---
    float max_r = mix(1.15f, 1.25f, close);
    if (r > max_r) {
        discard_fragment();
    }

    float distant_glow = pow(max(0.0f, 1.0f - r / 1.15f), 1.6f);
    float distant_core = smoothstep(1.0f, 0.0f, r);
    float distant_alpha = mix(distant_glow, distant_core, 0.5f);
    float4 distant_color = float4(in.color.rgb, distant_alpha);

    // A clearly defined spherical body with procedural photosphere granulation,
    // boiling plasma turbulence, sunspots, and dynamic solar corona
    float4 close_color;
    if (r <= 1.0f) {
        // Inside the solid physical sphere:
        // Calculate 3D sphere normal Z component in view space: Nz = sqrt(1 - r^2)
        float Nz = sqrt(max(0.0f, 1.0f - r * r));
        float3 N_view = float3(in.uv.x, in.uv.y, Nz);

        // Transform normal to 3D world space so the star reacts to camera orbit/rotation
        float3 N_world = normalize(N_view.x * in.cam_right + N_view.y * in.cam_up + N_view.z * in.cam_back);

        // Derive hot and cool spectral tones from in.color
        float4 baseCol = in.color;
        float4 hotCol = float4(mix(baseCol.rgb, float3(1.0f), 0.75f), 1.0f);
        float4 coolCol = float4(baseCol.rgb * float3(0.70f, 0.45f, 0.25f), 1.0f);
        float4 spotCol = float4(baseCol.rgb * 0.12f, 1.0f);

        // Evaluate procedural photosphere in world coordinates
        StarSurfaceSample surface = evaluate_star_surface(
            N_world,
            in.time,
            baseCol,
            hotCol,
            coolCol,
            spotCol,
            28.0f,    // Granulation scale
            1.0f,     // Turbulence
            0.65f,    // Sunspots
            0.05f,    // Differential rotation speed
            in.seed   // Unique per-star seed
        );

        // Realistic solar limb darkening: center is brightest, limb darkens smoothly
        float limb_darkening = 0.65f + 0.35f * pow(Nz, 0.65f);

        // Crisp, antialiased limb edge (narrow 1.5% transition to avoid pixel jaggies)
        float edge_alpha = smoothstep(1.0f, 0.985f, r);

        // Emissive surface with hot center
        float3 surface_rgb = surface.color * limb_darkening + (hotCol.rgb * 0.15f * pow(Nz, 2.2f));
        close_color = float4(surface_rgb, edge_alpha);
    } else {
        // Outside the physical sphere: glowing corona with 3D world-anchored magnetic streamers
        float coronaDist = (r - 1.0f) / 0.25f;
        float3 ray_world = normalize(in.uv.x * in.cam_right + in.uv.y * in.cam_up);
        float streamer = star_noise3d(ray_world * 3.5f + float3(0.0f, 0.0f, in.time * 0.2f));
        float streamers = 0.75f + 0.25f * streamer;

        float coronaFalloff = pow(max(0.0f, 1.0f - coronaDist), 2.5f);
        float coronaAlpha = coronaFalloff * streamers * 0.35f;
        float3 coronaColor = mix(in.color.rgb, float3(1.0f), pow(max(0.0f, 1.0f - coronaDist), 2.0f) * 0.4f);
        close_color = float4(coronaColor, coronaAlpha);
    }

    // Smoothly blend between distant radiant glow and close-up defined sphere
    float4 final_color = mix(distant_color, close_color, close);

    if (final_color.a < 0.01f) {
        discard_fragment();
    }

    out.color = final_color;

    // Depth writing:
    // When close-up and within the physical sphere (r <= 1.0), write exact depth
    // to occlude anything behind the star (e.g. Andromeda or background stars).
    // Outside the sphere (corona) or when distant, write far plane depth (1.0)
    // so background stars and star fields continue to blend seamlessly without clipping.
    out.depth = (close > 0.4f && r <= 1.0f) ? in.position.z : 1.0f;

    return out;
}