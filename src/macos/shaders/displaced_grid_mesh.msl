#include <metal_stdlib>
using namespace metal;

struct VertexIn {
  packed_float3 position;
};
struct VertexOut {
  float4 position [[position]];
};
struct Uniforms {
  float4x4 mvpMatrix;
  float4 gridColor;
};

vertex VertexOut grid_vertex(const device VertexIn *vertices [[buffer(0)]],
                           constant Uniforms &uniforms [[buffer(1)]],
                           uint vid [[vertex_id]]) {
  VertexOut out;
  out.position = uniforms.mvpMatrix * float4(vertices[vid].position, 1.0);
  return out;
}

fragment float4 grid_fragment(VertexOut in [[stage_in]], 
                              constant Uniforms &uniforms [[buffer(1)]]) {
  return uniforms.gridColor;
}